# deploy/vps/.env of asterism-chat: copy this file to .env (chmod 600) and
# change what you need (docs/install.md). docker compose reads it for the
# ${...} of docker-compose.yml, and the chat host gets every line as its
# environment (so the ASTERISM_CHAT_* lines reach it).

# The image: the published one, ghcr.io/ruby-asterism/asterism-chat:<version>.
# update.sh writes the version it pulled. Building it here instead
# (docker-compose.build.yml, update.sh --build): a name of your own, e.g.
# CHAT_IMAGE=asterism-chat-local, so a pull never replaces it.
CHAT_IMAGE=ghcr.io/ruby-asterism/asterism-chat
CHAT_VERSION=0.2.0

# The console's compose project: its network <project>_router is used by name.
ASTERISM_PROJECT=asterism

# The container's memory limit (docs/install.md, "Memory").
CHAT_MEM_LIMIT=192m

# The day of the daily limits (and of the records' files) is this time
# zone's date, and the devices show the times of the messages in it. The
# container's TZ comes from this line (docker-compose.yml), not from a TZ line.
CHAT_TZ=Asia/Tokyo

# The router: the console's .tar (a registry row "chat" with the role
# chat-host), put in credentials/ next to this file (chown 1000:1000,
# chmod 600). The router is zenohd on the console's network
# (CHAT_ROUTER, default tls/zenohd:7448), not the public name in the .tar.
ASTERISM_CHAT_CREDENTIALS=/credentials/chat.tar
# CHAT_ROUTER=tls/zenohd:7448
# The node ID (default chat): the same as the registry row's name, which
# is the certificate's (the role's ${node} is that name). A device looks
# for */chat/room, any node.
# ASTERISM_CHAT_NODE=chat

# The name the devices show for this chat host.
# ASTERISM_CHAT_NAME=Chat

# The rooms, in the order the devices show them: id:title, comma separated.
# id: a-z 0-9 _ -, up to 16 characters (it names the room's history file;
# changing a title keeps the history, changing an id starts a new room).
# The title may be Japanese (this file is UTF-8).
ASTERISM_CHAT_ROOMS=family:家族,games:ゲーム,friends:ともだち

# The devices that may come in: their node IDs, comma separated (the same
# ones that have the role "chat" in the console; a user's browser is
# wasm-<handle>). "*" lets any node that reaches the room in; the router's
# ACL (the role) still decides who reaches it.
ASTERISM_CHAT_DEVICES=fmruby-aaaaaa

# The limits (the defaults shown): messages kept per room, characters of
# one message and of a display name, posts (text or stamp) per device per
# day.
# ASTERISM_CHAT_HISTORY=500
# ASTERISM_CHAT_TEXT_MAX=200
# ASTERISM_CHAT_NAME_MAX=8
# ASTERISM_CHAT_PER_DAY=300

# The stamps (the defaults shown): pictures kept, and their bytes in all
# (16 MB); when a new one does not fit, the pictures no kept message points
# to go first. New pictures per device per day. How stamp_get sends a
# picture in MessagePack (str or bin).
# ASTERISM_CHAT_STAMPS_MAX=2000
# ASTERISM_CHAT_STAMPS_BYTES=16777216
# ASTERISM_CHAT_STAMPS_PER_DAY=30
# ASTERISM_CHAT_STAMP_BINARY=str

# Every other setting (README "Settings") in a TOML file of your own,
# mounted into the container, named here:
# ASTERISM_CHAT_CONFIG=/credentials/chat.toml
